<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_dialog_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvTuningHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="支持实时拖动和手输 0.1 精度，关闭后保留当前调节。"
            android:textColor="#99000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSectionAnchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="整体贴边"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemAnchorStart" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemAnchorEnd" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemAnchorBottom" />

        <TextView
            android:id="@+id/tvSectionLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="左侧主块"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemLocationCharsPerLine" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemLeftScale" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemLeftX" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemLeftY" />

        <TextView
            android:id="@+id/tvSectionTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="时间字微调"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemTimeSize" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemTimeGlow" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemTimeX" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemTimeY" />

        <TextView
            android:id="@+id/tvSectionRight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="右侧主块"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemRightScale" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemRightX" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemRightY" />

        <TextView
            android:id="@+id/tvSectionSecure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="防伪块"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureX" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureY" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureCodeSize" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureTitleScale" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureShadowScaleX" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureShadowScaleY" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureShadowX" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureShadowY" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemSecureCodeSpacing" />

        <TextView
            android:id="@+id/tvSectionImprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="左下验证行"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemRoomCodeHeight" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemRoomCodeTextSize" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemImprintIconWidth" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemImprintIconHeight" />
        <include layout="@layout/item_watermark_tuning_slider" android:id="@+id/itemImprintTextSize" />
    </LinearLayout>
</ScrollView>
