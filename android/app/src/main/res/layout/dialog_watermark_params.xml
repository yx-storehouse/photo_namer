<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_dialog_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="地址"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="手动填写；点定位天气可尝试回填"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:minLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="时间"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="留空则自动跟随当前时间，例如 19:14"
            android:imeOptions="actionNext"
            android:inputType="time" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="日期"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="留空则自动跟随当前日期，例如 2026.03.13 星期五"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="天气"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="手动填写；点定位天气可回填真实天气"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="备注块"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamRoomCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如 PK01"
            android:imeOptions="actionNext"
            android:inputType="textCapCharacters" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="底部备注"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamImprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="例如 今日水印相机已验证|时间地点真实"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:minLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="防伪码"
            android:textColor="#FF111111"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etParamAntiFakeCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="留空则随机生成 14 位"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters"
            android:maxLength="14" />

        <TextView
            android:id="@+id/btnRandomAntiFakeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_native_back_button"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="随机防伪码"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
